# ============================================================
# API and Database Testing Portfolio
# Public Repository Protection Rules
# ============================================================


# ------------------------------------------------------------
# Environment files and secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example

.npmrc
!.npmrc.example

*.secret
*.secrets
secrets/
private-secrets/

*.pem
*.key


# ------------------------------------------------------------
# Private Postman environments and unsanitized exports
# ------------------------------------------------------------

# Private/local Postman environment files
*.local.postman_environment.json
*.private.postman_environment.json
*.unsanitized.postman_environment.json

# Private Postman directories
postman/private/
postman/local/

# Raw, private, or unsanitized Postman exports at any depth
postman/**/*raw*.json
postman/**/*private*.json
postman/**/*unsanitized*.json

# Private Collection Runner results
**/[Rr]un-[Rr]esults/[Pp]rivate/

# Generic local JSON configuration
*.local.json


# ------------------------------------------------------------
# Node.js dependencies and package-manager logs
# ------------------------------------------------------------

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# Newman and generated Newman execution reports/results
# ------------------------------------------------------------

newman/
newman-report/
newman-reports/
newman-results/

reports/newman/
reports/generated/
reports/private/

*.newman.json


# ------------------------------------------------------------
# Database credentials, dumps, and local database files
# ------------------------------------------------------------

*.dump
*.backup.sql
*.private.sql
*.local.sql

*.db
*.sqlite
*.sqlite3

.pgpass
pgpass.conf


# ------------------------------------------------------------
# Local backups and temporary files
# ------------------------------------------------------------

[Bb]ackup/
[Bb]ackups/

*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.copy

* copy.*
* - Copy.*


# ------------------------------------------------------------
# Log and runtime files
# ------------------------------------------------------------

*.log
logs/
log/

*.pid
*.pid.lock


# ------------------------------------------------------------
# IDE and editor files
# ------------------------------------------------------------

.vscode/
.idea/
.history/

*.code-workspace


# ------------------------------------------------------------
# Operating-system generated files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Linux/editor backup files
*~


# ------------------------------------------------------------
# Microsoft Office temporary files
# ------------------------------------------------------------

~$*